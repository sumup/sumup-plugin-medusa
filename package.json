{
  "name": "@sumup/medusa-plugin",
  "version": "0.1.1",
  "description": "SumUp payment provider for Medusa v2.",
  "author": "SumUp <support@sumup.com> (https://sumup.com/)",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "./.medusa/server/src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumup/sumup-plugin-medusa.git"
  },
  "homepage": "https://github.com/sumup/sumup-plugin-medusa#readme",
  "bugs": {
    "url": "https://github.com/sumup/sumup-plugin-medusa/issues"
  },
  "packageManager": "yarn@1.22.22",
  "files": [
    ".medusa/server",
    "!.medusa/server/**/__tests__/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./.medusa/server/src/index.d.ts",
      "default": "./.medusa/server/src/index.js"
    },
    "./package.json": "./package.json",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js"
  },
  "keywords": [
    "medusa",
    "medusa-plugin",
    "medusa-v2",
    "medusa-plugin-integration",
    "medusa-plugin-payment",
    "sumup",
    "payments"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "medusa plugin:build"
  },
  "dependencies": {
    "@sumup/sdk": "^0.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@medusajs/cli": "2.22.6",
    "@medusajs/framework": "2.22.6",
    "@medusajs/medusa": "2.22.6",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "@typescript/typescript6": "^6.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@medusajs/framework": "^2.22.6"
  }
}
